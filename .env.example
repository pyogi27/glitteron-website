# Copy to .env.local and fill in. Server-only values must never get a NEXT_PUBLIC_ prefix.

# Backend API (lib/api/server.ts)
API_URL=http://localhost:3000

# Google Reviews banner (lib/api/googleReviews.ts). Server-only. Unset = banner hidden.
# See docs/GOOGLE-REVIEWS.md for how to get both values.
GOOGLE_PLACES_API_KEY=
GOOGLE_PLACE_ID=
